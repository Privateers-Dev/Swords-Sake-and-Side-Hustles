#══════════════════════════════════════════════════════════════════════
#		INGREDIENT QUERY FUNCTIONS
#		Read only - pull data from recipe_database
#══════════════════════════════════════════════════════════════════════

func get_ingredient(key: String) -> Dictionary:
	# Returns full ingredient data from database
	var db = _db()
	if db and db.INGREDIENTS.has(key):
		return db.INGREDIENTS[key]
	return{}
	
func get_ingredients_by_category(category: String) -> Array:
	# Returns all ingredient keys that belong in category
	var db		= _db()
	var result = []
	if not db:
		return result
	for key in db.INGREDIENTS:
		if db.INGREDIENTS[key]["category"] == category:
			result.append(key)
	return result
		
func get_available_ingredients(category: String) -> Array:
	# Returns only ingredient keys the player actually has in inventory
	var available = []
	for ingredient in get_ingredients_by_category(category):
		if has_ingredient(ingredient):
			available.append(ingredient)
	return available
	
func ingredient_exists(key: String) -> bool:
	# Check if an ingredient key exits in the database
	var db = _db()
	return db and db.INGREDIENTS.has(key)
	


##══════════════════════════════════════════════════════════════════════
#		RECIPE QUERY FUNCTIONS
#		Read only - pull data from recipe_database
##══════════════════════════════════════════════════════════════════════

func get_recipe(key: String) -> Dictionary:
	# Returns full recipe data from database
	var db = _db()
	if db and db.RECIPES.has(key):
		return db.RECIPES[key]
	return {}
	
func get_all_recipe_keys() -> Array:
	# Returns all recipe keys
	var db = _db()
	if not db:
		return[]
	return db.RECIPES.keys()
	
func recipe_exists(key: String) -> bool:
	# Checks if a recipe key exists in the database
	var db = _db()
	return db and db.RECIPES.has(key)
	
func get_recipe_action_sequence(recipe_key: String) -> Array:
	# Returns the action sequence for a recipe
	var recipe = get_recipe(recipe_key)
	if recipe.is_empty():
		return[]
	return recipe["action_sequence"]
	
	
#══════════════════════════════════════════════════════════════════════
#		INVENTORY FUNCTIONS
#══════════════════════════════════════════════════════════════════════

func has_ingredient(ingredient: String) -> bool:
	# Checks if player has at least 1 of this ingredient
	return inventory.has(ingredient) and inventory[ingredient] > 0
	
func use_ingredient(ingredient: String) -> bool:
	# Removes 1 of an ingredient from inventory when cooking
	if has_ingredient(ingredient):
		inventory[inventory] -= 1
		var data = get_ingredient(ingredient)
		if not data.is_empty():
			print("Used: ", data["name"])
		return true
	print("Out of:", ingredient)
	return false
	
func add_ingredient(ingredient: String, amount: int = 1) -> bool:
	# Adds ingredients to inventory
	# Checks capacity via upgrade_manager if available
	if not ingredient_exists(ingredient):
		return false
	var upgrades = _upgrades()
	if upgrades:
		if not upgrades.can_add_ingredient(ingredient, amount, inventory, _db().INGREDIENTS):	
			var category = get_ingredient(ingredient)["category"]
			print("Storage full! ", category, "is at max capacity of ",
				upgrades.get_max_capacity(category))
			return false
	if inventory.has(ingredient):
		inventory[inventory] += amount
	else:
		inventory[ingredient] = amount
	var data = get_ingredient(ingredient)
	if not data.is_empty():
		print("Added ", amount, "x ", data["name"], " to inventory")
	return true
	
	
#══════════════════════════════════════════════════════════════════════
#		COOKING SESSION FUNCTIONS
#══════════════════════════════════════════════════════════════════════

func start_cooking(recipe_key: String, ingredients: Array, garnishes: Array = []) -> bool:
	# Called when player confirms recipe and ingredients
	if not recipe_exists(recipe_key):
		print("Recipe not found: ", recipe_key)
		return false
		
	var recipe = get_recipe(recipe_key)
	
	current_recipe			= recipe_key
	chosen_ingredients		= ingredients
	chosen_garnishes		= garnishes
	current_action_index	= 0
	cook_quality			= 0.0
	garnish_quality_bonus	= 0.0
	
	# Use up the ingredients from inventory
	for ingredient in ingredients:
		use_ingredient(ingredient)
		
	# Apply garnish bonuses and use garnish items
	for garnish in garnishes:
		use_ingredient(garnish)
		if recipe["garnish_bonuses"].has(garnish):
			garnish_quality_bonus += recipe["garnish_bonuses"][garnish]
			print("Garnish bonus: +", recipe["garnish_bonuses"][garnish], "from", garnish)
			
	print("Starting: ", recipe["name"])
	print("Actions: ", recipe["action_sequence"])
	return true

func get_current_action() -> String:
	# Returns the action the player needs to perform right now
	if current_recipe == "":
		return ""
	var sequence = get_recipe_action_sequence(current_recipe)
	if current_action_index < sequence.size:
		return sequence[current_action_index]
	return "done"
	
func complete_action(quality: float) -> void:
	# Called by gesture_manager when player completes a cooking gesture
	# quality is 0.0 to 1.0 — how well they performed it
	cook_quality		+= quality
	current_action_index += 1
	print("Action complete! Quallity: ", quality)
	print("Next action: ", get_current_action())
	
func finish_cooking() -> Dictionary:
	# Called when all actions done — calculates and returns the result
	var recipe		= get_recipe(current_recipe)
	var num_actions = recipe["action_sequence"].size()
	
	# Average quality across all actions plus garnish bonuses
	var avg_quality = (cook_quality / num_actions) + garnish_quality_bonus
	avg_quality		= clamp(avg_quality, 0.0, 10.0)
	
	# Determine rating
	var rating = ""
	if avg_quality >= 0.9:
		rating = "perfect"
	elif avg_quality >= 0.7:
		rating = "good"
	elif avg_quality >= 0.4:
		rating = "undercooked"
	else:
		rating = "burned"
		
	# Calculate final price based on rating
	var final_price = calculate_dish_value(current_recipe, chosen_ingredients)
	match rating:
		"perfect":			final_price = int(final_price * 1.5)
		"good":				final_price = int(final_price * 1.0)
		"undercooked":  	final_price = int(final_price * 0.6)
		"burned":			final_price = 0
		
	var result = {
		"recipe":			current_recipe,
		"rating":			rating,
		"quality":			avg_quality,
		"final_price":		final_price,
		"ingredients":		chosen_ingredients,
		"garnishes":		chosen_garnishes,
		
	}
	
	print("=== COOKING RESULT ===")
	print("Dish:	", recipe["name"])
	print("Rating:	", rating)
	print("Quality:	", avg_quality)
	print("Value:	", final_price, "coins")
	
	# Reset session ready for next dish
	current_recipe			= ""
	chosen_ingredients		= []
	chosen_garnishes		= []
	current_action_index	= 0
	cook_quality			= 0.0
	garnish_quality_bonus	= 0.0
	
	return result
	
func calculate_dish_value(recipe_key: String, ingredients: Array) -> int:
	# Calculate final sell price based on ingredients used
	var recipe = get_recipe(recipe_key)
	if recipe.is_empty():
		return 0
	var base = recipe["base_price"]
	var bonus = 1.0
	for ingredient in ingredients:
		var data = get_ingredient(ingredient)
		if not data.is_empty():
			match data["rarity"]:
				"rare":		bonus += 0.3
				"exotic":	bonus = recipe["exotic_bonus"]
	return int(base * bonus)
	
	
