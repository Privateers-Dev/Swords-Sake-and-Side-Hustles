	"garnish":		0,
	"alcohol":		0,
}

# How much each upgrade level adds to capacity
const UPGRADE_BONUS = 10
# Max upgrade level per category
const MAX_UPGRADE_LEVEL = 5

const UPGRADE_COSTS = {
	1: 200,
	2: 400,
	3: 800,
	4: 1500,
	5: 3000,
}

#═══════════════════════════════════════════════════════════════
#			APPLIANCE FUNCTIONS
#═══════════════════════════════════════════════════════════════

func get_appliance_tier(appliance: String) -> int:
	# Returns current tier of an appliance 0-3
	if not appliance_tiers.has(appliance):
		return 0
	return appliance_tiers[appliance]
	
func get_appliance_data(appliance: String) -> Dictionary:
	# Returns full appliance data for current tier
	if not APPLIANCES.has(appliance):
		return{}
	var tier = get_appliance_tier(appliance)
	return APPLIANCES[appliance]["tiers"][tier]
	
func get_appliance_bonus(appliance: String, bonus_key: String) -> float:
	# Returns a specific bonus value for the current appliance tier
	var data = get_appliance_data(appliance)
	if data.is_empty() or not data.has("unlocks"):
		return false
	return data [bonus_key]
	
func is_unlocked(appliance: String, feature: String) -> bool:
	# Check if a specific feature is unlocked for an appliance
	var data = get_appliance_data(appliance)
	if data.is_empty() or not data.has("unlocks"):
		return false
	return feature in data["unlocks"]
	
func can_upgrade_appliance(appliance: String) -> bool:
	# Check if appliance can be upgraded — needs more captured oni
	if not APPLIANCES.has(appliance):
		return false
	var current_tier = get_appliance_tier(appliance)
	if current_tier >= 3:
		return false
	var required_oni 	= APPLIANCES[appliance]["oni"]
	var captured		= captured_oni[required_oni]
	#	Need 1 oni for tier 1, 2 for tier 2, 3 for tier 3
	return captured > current_tier
	
	
#═══════════════════════════════════════════════════════════════
#					ONI CAPTURE FUNCTIONS
#═══════════════════════════════════════════════════════════════
	
func capture_oni(oni_type: String) -> Dictionary:
	# Called when player successfully captures an elemental oni
	if not captured_oni.has(oni_type):
		return{"success": false, "message": "Unkown oni type: " + oni_type}
		
		
	captured_oni[oni_type] += 1
	var count = captured_oni[oni_type]
	
	print("Captured", oni_type, "! Total: ", count)
	
	# Check if this unlocks an appliance upgrade
	var appliance = _get_appliance_for_oni(oni_type)
	if appliance != "" and can_upgrade_appliance(appliance):
		return{
			"success":		true,
			"message":		oni_type + " captured! " + APPLIANCES[appliance]["name"] + " can now be upgraded!",
			"can_upgrade":	true,
			"appliance":	appliance,
		}
	return {
		"success":		true,
		"message":		oni_type + " captured! Total: " + str(count),
		"can_upgrade":	false,
		"appliance": 	appliance,
	}
	
func assign_oni_to_appliance(appliance: String) -> Dictionary:
	# Upgrades an appliance by assigning a captured oni to it
	if not can_upgrade_appliance(appliance):
		return{"success": false, "message": "Cannot upgrade " + appliance + " — cpature more oni first!"}
	
	appliance_tiers[appliance] += 1
	var new_tier = appliance_tiers[appliance]
	var tier_data = APPLIANCES[appliance]["tiers"][new_tier]
	
	print("=== APPLIANCE UPGRADED ===")
	print(APPLIANCES[appliance]["name"], " -> ", tier_data["name"])
	print(tier_data["description"])
	return {
		"success":		true,
		"appliance":	appliance,
		"new_tier":		new_tier,
		"tier_name":	tier_data["name"],
		"message":		tier_data["description"],
		"unlocks":		tier_data["unlocks"],
	}
	
func _get_appliance_for_oni(oni_type: String) -> String:
	# Returns which appliance an oni type upgrades
	for appliance in APPLIANCES:
		if APPLIANCES[appliance]["oni"] == oni_type:
			return appliance
	return ""
#═══════════════════════════════════════════════════════════════
#					CAPACITY FUNCTIONS
#═══════════════════════════════════════════════════════════════
	
func get_max_capacity(category: String) -> int:
	if not BASE_CAPACITY.has(category):
		return 99
	return BASE_CAPACITY[category] + (storage_upgrades[category] * UPGRADE_BONUS)
	
func can_add_ingredient(ingredient: String, amount: int, inventory: Dictionary, ingredients: Dictionary) -> bool:
	if not ingredients.has(ingredient):
		return false
	var category = ingredients[ingredient]["category"]
	var current = get_category_total(category, inventory, ingredients)
	return current + amount <= get_max_capacity(category)
	
func get_category_total(category: String, inventory: Dictionary, ingredients: Dictionary) -> int:
	var total = 0
	for item in inventory:
		if ingredients.has(item) and ingredients[item]["category"] == category:
			total += inventory[item]
	return total
	
func get_category_space_remaining(category: String, inventory: Dictionary, ingredients: Dictionary) -> int:
	return get_max_capacity(category) - get_category_total(category, inventory, ingredients)
	
func upgrade_storage(category: String, player_coins: int) -> Dictionary:
	if not storage_upgrades.has(category):
		return{"success": false, "coins_remaining": player_coins, "message": "Unknown category"}
	if storage_upgrades[category] >= MAX_UPGRADE_LEVEL:
		return{"success": false, "coins_remaining": player_coins, "message": " Already at max level"}
	var next_level = storage_upgrades[category] + 1
	var cost	   = UPGRADE_COSTS[next_level]
	if player_coins < cost:
		return {"success": false, "coins_remaining": player_coins, "message": "Need " + str(cost) + "coins"}
	storage_upgrades[category] += 1
	return {
			"success":			true,
			"coins_remaining":  player_coins - cost,
			"message":			category + "storage upgraded to" + str(get_max_capacity(category)),
		}

